# Google Sheets 配置
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_CREDENTIALS_ID=your_google_oauth_credentials_id

# Google Drive 配置
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_DRIVE_CREDENTIALS_ID=your_google_oauth_credentials_id

# Anthropic API 配置
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# SMTP 邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_TO_EMAIL=recipient@example.com
SMTP_ADMIN_EMAIL=admin@example.com

# 工作流配置
CRON_SCHEDULE=0 9 * * 1,4
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_MS=5000
REQUEST_TIMEOUT_MS=30000

# 广告平台配置（根据需要选择）
FACEBOOK_ACCESS_TOKEN=your_fb_access_token
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_token
TIKTOK_ACCESS_TOKEN=your_tiktok_token

# 可选: 代理配置（如果需要）
# HTTP_PROXY=http://proxy-server:port
# HTTPS_PROXY=https://proxy-server:port

# 可选: Slack 通知（替代或补充邮件）
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx
# SLACK_CHANNEL=#ad-monitoring

# 可选: Discord 通知
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx

# 可选: 企业微信通知
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxx

# 调试模式
DEBUG=false
LOG_LEVEL=info
